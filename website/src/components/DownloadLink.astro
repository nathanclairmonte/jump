---
import BrandIcon from "./BrandIcon.astro";
import { PLATFORMS } from "../lib/download.mjs";
interface Props {
  platform: "mac" | "windows";
  secondary?: boolean;
}
const { platform, secondary = false } = Astro.props;
const target = PLATFORMS[platform];
const icon = platform === "mac" ? "apple" : "windows";
const label = platform === "mac" ? "Download for macOS" : "Windows";
---

<a
  class:list={["button", { secondary }]}
  href={target.href}
  aria-label={`Download for ${target.label}`}
>
  <BrandIcon name={icon} />
  <span>{label}</span>
</a>
