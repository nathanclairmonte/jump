---
import { PLATFORMS } from "../lib/download.mjs";
interface Props {
  platform: "mac" | "windows";
  secondary?: boolean;
}
const { platform, secondary = false } = Astro.props;
const target = PLATFORMS[platform];
---

<a class:list={["button", { secondary }]} href={target.href}>
  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path
      d="M10 3v9m-3-3 3 3 3-3M4 13v4h12v-4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  Download for {target.label}
</a>
