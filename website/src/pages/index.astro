---
import "../styles/global.css";
import { Picture } from "astro:assets";
import launcher from "../assets/launcher.png";
import BrandIcon from "../components/BrandIcon.astro";
import DownloadLink from "../components/DownloadLink.astro";
import { RELEASE_PAGE } from "../lib/download.mjs";
const title = "Jump | Open projects in VS Code, Cursor, or Zed.";
const description =
  "Open projects in VS Code, Cursor, or Zed. Type a project name and press Enter. Jump finds projects in your folders, including WSL.";
const canonical = new URL("/", Astro.site);
const faqs = [
  [
    "Is Jump open source?",
    "Yes. Jump is free to use, modify, and share under the MIT license. You can find the source code on GitHub.",
  ],
  [
    "How does Jump find my projects?",
    "Choose the folders you keep projects in. Jump scans them for project markers such as .git, package.json, Cargo.toml, and pyproject.toml. You can also add a project manually.",
  ],
  [
    "Which editors can I use?",
    "VS Code, Cursor, and Zed. Choose a default editor, set a different editor for an individual project, or use Open With for a one-time choice. For Zed with WSL, Jump runs the Linux zed command inside your distribution. That setup is best-effort.",
  ],
  [
    "Does Jump work with WSL?",
    "Yes. The Windows app can find projects in your WSL2 distributions and open them through VS Code or Cursor. Native Windows projects and WSL projects appear in the same launcher.",
  ],
  [
    "Does Jump upload my code?",
    "No. Jump scans the folders you choose and stores its project index and settings on your computer. You do not need an account.",
  ],
  [
    "Can I change the shortcut?",
    "Yes. The default is Ctrl + Alt + Space, or Control + Option + Space on macOS. You can change it in Settings. Use the arrow keys to choose a project, Enter to open it, and Tab for project actions.",
  ],
  [
    "Is there an Intel Mac or Linux build?",
    "The current builds are for Apple Silicon Macs and x64 Windows PCs. There is no Intel Mac or standalone Linux build. WSL2 projects are supported through the Windows app.",
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141210" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/images/social.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Jump. Open projects in VS Code, Cursor, or Zed."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <nav aria-label="Site navigation">
        <a
          class="github-link"
          href="https://github.com/nathanclairmonte/jump"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Source on GitHub (opens in a new tab)"
          title="Source on GitHub"
        >
          <BrandIcon name="github" />
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <div class="brand">
            <img src="/images/icon.png" width="68" height="68" alt="" />
            <h1 id="hero-heading">Jump</h1>
          </div>
          <p class="lead">Open projects in VS Code, Cursor, or Zed.</p>
          <p class="description">
            Type a project name and press Enter. Jump finds projects in your
            folders, including WSL.
          </p>
          <div
            class="shortcut"
            role="img"
            aria-label="Open Jump with Control, Alt, and Space"
          >
            <span class="shortcut-label">Open Jump with</span>
            <span class="shortcut-keys" aria-hidden="true">
              <kbd>Ctrl</kbd>
              <kbd>Alt</kbd>
              <kbd class="space-key">Space</kbd>
            </span>
          </div>
          <div class="hero-actions">
            <DownloadLink platform="mac" />
            <DownloadLink platform="windows" secondary />
          </div>
          <p class="requirements">macOS 13+ on Apple Silicon. Windows x64.</p>
          <p class="installation-link">
            Unsigned builds.{" "}
            <a href="#installation">Read the installation notes</a>.
          </p>
        </div>
        <figure class="hero-visual">
          <div class="launcher-stage">
            <Picture
              src={launcher}
              formats={["avif", "webp"]}
              widths={[600, 900, 1200]}
              sizes="(max-width: 620px) min(500px, calc(100vw - 44px)), (max-width: 899px) calc((100vw - 92px) * 0.525), (max-width: 1176px) calc((100vw - 158px) * 0.525), 535px"
              loading="eager"
              fetchpriority="high"
              alt="Jump showing pinned projects and recently opened projects"
            />
          </div>
        </figure>
      </section>
      <section
        class="information wrap"
        id="installation"
        aria-labelledby="installation-heading"
      >
        <h2 id="installation-heading">Installation</h2>
        <div class="information-content">
          <p class="availability" id="availability">
            If your download did not start, the installer may be unavailable or
            GitHub may be temporarily unreachable. Try again later or{" "}
            <a href={RELEASE_PAGE}>check the releases on GitHub</a>.
          </p>
          <article id="install-mac">
            <h3>macOS</h3>
            <p>
              Requires macOS 13 or later on Apple Silicon. The current app is
              unsigned and unnotarized.
            </p>
            <details>
              <summary>
                macOS installation steps <span aria-hidden="true">+</span>
              </summary>
              <div class="install-instructions">
                <ol>
                  <li>Open the DMG and drag Jump into Applications.</li>
                  <li>Run this command in Terminal before opening Jump.</li>
                </ol>
                <pre><code>xattr -cr /Applications/Jump.app</code></pre>
                <p>
                  This clears quarantine for the unsigned app. Repeat after each
                  new download. Without this step, macOS may say the app is
                  damaged.
                </p>
              </div>
            </details>
          </article>
          <article id="install-windows">
            <h3>Windows</h3>
            <p>
              Requires Windows x64. Use WSL2 to add projects from a Linux
              distribution.
            </p>
            <details>
              <summary>
                Windows installation steps <span aria-hidden="true">+</span>
              </summary>
              <div class="install-instructions">
                <p>
                  Run the x64 setup installer. Jump installs for your Windows
                  user and runs in the system tray.
                </p>
                <p>
                  The installer is unsigned, so Windows may show a SmartScreen
                  warning.
                </p>
              </div>
            </details>
          </article>
        </div>
      </section>
      <section
        class="faq information wrap"
        id="questions"
        aria-labelledby="faq-heading"
      >
        <h2 id="faq-heading">Questions</h2>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <p>
        Free and open source.{" "}
        <a href="https://github.com/nathanclairmonte/jump/blob/main/LICENSE">
          MIT licensed.
        </a>
      </p>
    </footer>
  </body>
</html>
